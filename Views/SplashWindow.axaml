<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MegaDatos.Views.SplashWindow"
        Title="Iniciando MegaDatos"
        Width="500" Height="300"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent">
    
    <Border Background="{DynamicResource BgPrimaryBrush}" 
            CornerRadius="16" 
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1"
            BoxShadow="0 10 30 0 #40000000">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
            <!-- Icono animado o estático -->
            <Image Source="avares://MegaDatos/Assets/nuevo icono.png" 
                   Width="120" Height="120" 
                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
            
            <TextBlock Text="MegaDatos" 
                       FontSize="36" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"/>
            
            <TextBlock x:Name="StatusText"
                       Text="Iniciando componentes..." 
                       FontSize="14" 
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"/>
            
            <ProgressBar IsIndeterminate="True" 
                         Width="200" 
                         Height="4" 
                         Margin="0,10,0,0"
                         Foreground="{DynamicResource AccentBrush}"/>
        </StackPanel>
    </Border>
</Window>
