<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MegaDatos.ViewModels"
        xmlns:models="using:MegaDatos.Models"
        x:Class="MegaDatos.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="MegaDatos — Gestor de Metadatos"
        Width="1400" Height="850"
        MinWidth="1000" MinHeight="600"
        Background="{DynamicResource BgPrimaryBrush}"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <DataTemplate x:Key="MetadataEntryTemplate" DataType="models:MetadataEntry">
            <DockPanel Margin="0,3">
                <TextBlock DockPanel.Dock="Left" Text="{Binding Key}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" Width="95" VerticalAlignment="Center" />
                <Grid>
                    <!-- ReadOnly Mode -->
                    <TextBlock IsVisible="{Binding !IsEditable}" Text="{Binding Value}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0,0,0" />
                    
                    <!-- Editable Mode -->
                    <Grid IsVisible="{Binding IsEditable}">
                        <!-- TextBox (Default) -->
                        <TextBox IsVisible="{Binding IsTextEditor}" Text="{Binding Value, Mode=TwoWay}" Classes="meta-input" FontSize="11" Padding="6,4" Background="{DynamicResource BgSecondaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderDefaultBrush}" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        
                        <!-- Date Picker -->
                        <CalendarDatePicker IsVisible="{Binding IsDateEditor}" SelectedDate="{Binding ValueAsDate, Mode=TwoWay}" Classes="meta-input" FontSize="11" Padding="6,4" Background="{DynamicResource BgSecondaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderDefaultBrush}" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        
                        <!-- Rating Picker -->
                        <ComboBox IsVisible="{Binding IsRatingEditor}" SelectedItem="{Binding Value, Mode=TwoWay}" Classes="meta-input" FontSize="11" Padding="6,4" Background="{DynamicResource BgSecondaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderDefaultBrush}" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                            <x:String>★☆☆☆☆</x:String>
                            <x:String>★★☆☆☆</x:String>
                            <x:String>★★★☆☆</x:String>
                            <x:String>★★★★☆</x:String>
                            <x:String>★★★★★</x:String>
                        </ComboBox>
                        
                        <!-- Choice Picker (ComboBox) -->
                        <ComboBox IsVisible="{Binding IsChoiceEditor}" ItemsSource="{Binding Choices}" SelectedItem="{Binding Value, Mode=TwoWay}" Classes="meta-input" FontSize="11" Padding="6,4" Background="{DynamicResource BgSecondaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderDefaultBrush}" VerticalAlignment="Center" HorizontalAlignment="Stretch" />

                        <!-- GPS Decimal Editor -->
                        <Grid IsVisible="{Binding IsGpsDecimalEditor}" ColumnDefinitions="*,6,50">
                            <TextBox Grid.Column="0" Text="{Binding DecimalDegreesValue, Mode=TwoWay}" Classes="meta-input" FontSize="11" Padding="6,4" Background="{DynamicResource BgSecondaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderDefaultBrush}" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding HemisphereChoices}" SelectedItem="{Binding Hemisphere, Mode=TwoWay}" Classes="meta-input" FontSize="11" Padding="6,4" Background="{DynamicResource BgSecondaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderDefaultBrush}" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </Grid>

                        <!-- GPS DMS Editor -->
                        <Grid IsVisible="{Binding IsGpsDmsEditor}" ColumnDefinitions="*,2,*,2,*,4,50">
                            <TextBox Grid.Column="0" Text="{Binding DmsDegrees, Mode=TwoWay}" Classes="meta-input" FontSize="10" Padding="4,4" PlaceholderText="°" ToolTip.Tip="Grados" Background="{DynamicResource BgSecondaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderDefaultBrush}" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                            <TextBox Grid.Column="2" Text="{Binding DmsMinutes, Mode=TwoWay}" Classes="meta-input" FontSize="10" Padding="4,4" PlaceholderText="'" ToolTip.Tip="Minutos" Background="{DynamicResource BgSecondaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderDefaultBrush}" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                            <TextBox Grid.Column="4" Text="{Binding DmsSeconds, Mode=TwoWay}" Classes="meta-input" FontSize="10" Padding="4,4" PlaceholderText="&quot;" ToolTip.Tip="Segundos" Background="{DynamicResource BgSecondaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderDefaultBrush}" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                            <ComboBox Grid.Column="6" ItemsSource="{Binding HemisphereChoices}" SelectedItem="{Binding Hemisphere, Mode=TwoWay}" Classes="meta-input" FontSize="11" Padding="6,4" Background="{DynamicResource BgSecondaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderDefaultBrush}" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </Grid>
                    </Grid>
                </Grid>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <DockPanel LastChildFill="True">

        <!-- ============================================================ -->
        <!-- TOP: Toolbar (Igual al de Antigravity / Solicitado) -->
        <!-- ============================================================ -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <DockPanel>
                <!-- Logo / App Name -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="◆" FontSize="20" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="MegaDatos" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource BgHoverBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="4,0,0,0">
                        <TextBlock Text="PRO" FontSize="10" Foreground="{DynamicResource AccentSecondaryBrush}" FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <!-- Right side actions -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Classes="toolbar-btn" Content="⚙️ Ajustes" Command="{Binding NavigateToolCommand}" CommandParameter="Settings" />
                </StackPanel>

                <!-- Center toolbar actions -->
                <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Classes="toolbar-btn" Content="📂 Seleccionar Directorio" Command="{Binding OpenFolderCommand}" />
                    <Border Width="1" Height="20" Background="{DynamicResource BorderSubtleBrush}" Margin="6,0" />
                    <Button Classes="toolbar-btn" Content="🔄 Sincronizar" Command="{Binding RefreshFilesCommand}" />
                    <Border Width="1" Height="20" Background="{DynamicResource BorderSubtleBrush}" Margin="6,0" />
                    <Button Classes="toolbar-btn" Content="💾 Guardar Todo" Command="{Binding SaveMetadataCommand}" />
                    <Button Classes="toolbar-btn" Content="🧹 Limpieza Local" Command="{Binding StripMetadataCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================ -->
        <!-- BOTTOM: Status Bar -->
        <!-- ============================================================ -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,5">
            <DockPanel>
                <!-- Left status info -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="📁" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="Archivos:" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TotalFiles}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="✓" FontSize="11" Foreground="{DynamicResource AccentSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Seleccionados:" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SelectedCount}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Right: Memory / Security -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="💾" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Text="Uso RAM:" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding MemoryUsage}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <Border Width="1" Height="14" Background="{DynamicResource BorderSubtleBrush}" Margin="8,0" />
                    <TextBlock Text="🛡️" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Text="Procesamiento 100% Local" FontSize="11" Foreground="{DynamicResource AccentSuccessBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center: Status -->
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Classes="tag">
                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================ -->
        <!-- MAIN CONTENT: 5-Column layout inspired by Antigravity IDE -->
        <!-- ============================================================ -->
        <Grid ColumnDefinitions="48,250,1,*,1,360">

            <!-- ========================================== -->
            <!-- 1. BARRA DE HERRAMIENTAS PRINCIPALES (48px)-->
            <!-- ========================================== -->
            <Border Grid.Column="0"
                    Background="#09090D"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Main Navigation Tools -->
                    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,8,0,0">
                        <!-- Explorer -->
                        <Button Classes="activity-btn"
                                Classes.active="{Binding IsExplorerActive}"
                                Content="📂"
                                Command="{Binding NavigateToolCommand}"
                                CommandParameter="Explorer"
                                ToolTip.Tip="Explorador de Archivos" />
                        <!-- Editor -->
                        <Button Classes="activity-btn"
                                Classes.active="{Binding IsEditorActive}"
                                Content="✏️"
                                Command="{Binding NavigateToolCommand}"
                                CommandParameter="Editor"
                                ToolTip.Tip="Editor de Metadatos" />
                        <!-- GPS -->
                        <Button Classes="activity-btn"
                                Classes.active="{Binding IsGpsActive}"
                                Content="🌍"
                                Command="{Binding NavigateToolCommand}"
                                CommandParameter="GPS"
                                ToolTip.Tip="Editor de Geolocalización" />
                        <!-- Batch -->
                        <Button Classes="activity-btn"
                                Classes.active="{Binding IsBatchActive}"
                                Content="📦"
                                Command="{Binding NavigateToolCommand}"
                                CommandParameter="Batch"
                                ToolTip.Tip="Procesamiento por Lotes" />
                        <!-- Strip -->
                        <Button Classes="activity-btn"
                                Classes.active="{Binding IsStripActive}"
                                Content="🧹"
                                Command="{Binding NavigateToolCommand}"
                                CommandParameter="Strip"
                                ToolTip.Tip="Saneamiento de Archivos" />
                    </StackPanel>

                    <!-- Bottom Navigation Tools (Settings) -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
                        <Button Classes="activity-btn"
                                Content="⚙️"
                                Command="{Binding NavigateToolCommand}"
                                CommandParameter="Settings"
                                ToolTip.Tip="Ajustes de la Aplicación" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ========================================== -->
            <!-- 2. DESPLIEGUE DE LA HERRAMIENTA (SIDEBAR 250px)-->
            <!-- ========================================== -->
            <Border Grid.Column="1"
                    Background="{DynamicResource BgSecondaryBrush}"
                    Padding="10,12"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <!-- Sub-view 1: Folder Tree (Explorer Active) -->
                    <DockPanel IsVisible="{Binding IsExplorerActive}">
                        <TextBlock DockPanel.Dock="Top" Text="Directorios" Classes="section-header" Margin="6,0,0,10" />
                        <TreeView ItemsSource="{Binding FolderTree}"
                                  Background="Transparent">
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate ItemsSource="{Binding Children}" DataType="models:FolderNode">
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" Padding="2,3" />
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>

                    <!-- Sub-view 2: Editor Inputs (Editor Active) -->
                    <ScrollViewer IsVisible="{Binding IsEditorActive}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Editor de Metadatos" Classes="section-header" Margin="6,0,0,5" />
                            
                            <StackPanel Spacing="4">
                                <TextBlock Text="Autor" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Classes="meta-input" Text="{Binding EditAuthor}" PlaceholderText="Ej: Juan Pérez" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Copyright" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Classes="meta-input" Text="{Binding EditCopyright}" PlaceholderText="Ej: © 2026 Juan Pérez" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Software" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Classes="meta-input" Text="{Binding EditSoftware}" PlaceholderText="Ej: Photoshop" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Etiquetas (tags)" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Classes="meta-input" Text="{Binding EditTags}" PlaceholderText="vacaciones, naturaleza" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Descripción" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Classes="meta-input" Text="{Binding EditDescription}" AcceptsReturn="True" Height="70" TextWrapping="Wrap" PlaceholderText="Descripción del archivo..." />
                            </StackPanel>

                            <Button Classes="action-btn" Content="💾 Guardar Cambios" Command="{Binding SaveMetadataCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,10,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sub-view 3: GPS Inputs (GPS Active) -->
                    <ScrollViewer IsVisible="{Binding IsGpsActive}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Geolocalización (GPS)" Classes="section-header" Margin="6,0,0,5" />

                            <StackPanel Spacing="4">
                                <TextBlock Text="Latitud" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Classes="meta-input" Text="{Binding GpsLatitude}" PlaceholderText="Ej: 4.7110" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Longitud" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Classes="meta-input" Text="{Binding GpsLongitude}" PlaceholderText="Ej: -74.0721" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Altitud (m)" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Classes="meta-input" Text="{Binding GpsAltitude}" PlaceholderText="Ej: 2640" />
                            </StackPanel>

                            <Border Background="{DynamicResource BgHoverBrush}" CornerRadius="4" Padding="8" Margin="0,4">
                                <TextBlock Text="⚠️ La ubicación expone datos sensibles. Si vas a compartir la foto, se aconseja borrar el GPS." FontSize="10.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>

                            <Button Classes="action-btn" Content="💾 Aplicar Coordenadas" Command="{Binding SaveMetadataCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,6,0,0" />
                            <Button Classes="danger-btn" Content="🗑️ Eliminar GPS" Command="{Binding ClearGpsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sub-view 4: Batch Panel (Batch Active) -->
                    <ScrollViewer IsVisible="{Binding IsBatchActive}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Procesamiento Lote" Classes="section-header" Margin="6,0,0,5" />

                            <StackPanel Spacing="4">
                                <TextBlock Text="Acción" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox SelectedIndex="0" HorizontalAlignment="Stretch" Classes="meta-input">
                                    <ComboBoxItem Content="Saneamiento total" />
                                    <ComboBoxItem Content="Inyectar Autor/Copy" />
                                    <ComboBoxItem Content="Limpiar GPS" />
                                </ComboBox>
                            </StackPanel>

                            <CheckBox IsChecked="{Binding BatchBackupEnabled}" Margin="0,4">
                                <TextBlock Text="Crear backup (.bak)" FontSize="11" />
                            </CheckBox>

                            <Border Background="{DynamicResource BgHoverBrush}" CornerRadius="4" Padding="8" Margin="0,2">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="DESTINO:" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBlock Text="Directorio Activo" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <!-- Progress panel -->
                            <StackPanel Spacing="6" Margin="0,6">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding BatchStatusText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock DockPanel.Dock="Right" Text="12 / 12 arch." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </DockPanel>
                                <ProgressBar Value="100" Classes="status-progress" />
                            </StackPanel>

                            <Button Classes="action-btn" Content="⚡ Iniciar Lote" Command="{Binding ExecuteBatchCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sub-view 5: Stripping Panel (Strip Active) -->
                    <ScrollViewer IsVisible="{Binding IsStripActive}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Saneamiento (Strip)" Classes="section-header" Margin="6,0,0,5" />

                            <CheckBox IsChecked="True" Margin="0,2"><TextBlock Text="Metadatos EXIF" FontSize="11" /></CheckBox>
                            <CheckBox IsChecked="True" Margin="0,2"><TextBlock Text="Geolocalización GPS" FontSize="11" /></CheckBox>
                            <CheckBox IsChecked="True" Margin="0,2"><TextBlock Text="Datos de Autoría" FontSize="11" /></CheckBox>
                            <CheckBox IsChecked="True" Margin="0,2"><TextBlock Text="Historial de Software" FontSize="11" /></CheckBox>

                            <Border Background="#2D1111" BorderBrush="#5D2222" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,4">
                                <TextBlock Text="🔴 ATENCIÓN: El borrado es irreversible y se guarda directamente al archivo." FontSize="10.5" TextWrapping="Wrap" Foreground="#F0B6B6" />
                            </Border>

                            <Button Classes="danger-btn" Content="🧹 Sanear Archivos" Command="{Binding StripMetadataCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Separator 1 -->
            <Border Grid.Column="2" Background="{DynamicResource BorderSubtleBrush}" />

            <!-- ========================================== -->
            <!-- 3. EXPLORADOR DE ARCHIVOS (CENTER PANEL)   -->
            <!-- ========================================== -->
            <Border Grid.Column="3" Background="{DynamicResource BgPrimaryBrush}">
                <DockPanel>
                    <!-- Path Bar / Search -->
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource BgSecondaryBrush}"
                            Padding="12,8"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <!-- Vista Switcher (ComboBox) on the right -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="👁️ Vista:" FontSize="11.5" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox ItemsSource="{Binding ViewTypes}"
                                          SelectedItem="{Binding SelectedViewType}"
                                          FontSize="11"
                                          Height="28"
                                          Padding="8,4"
                                          Background="{DynamicResource BgTertiaryBrush}"
                                          BorderBrush="{DynamicResource BorderDefaultBrush}"
                                          BorderThickness="1"
                                          CornerRadius="6"
                                          VerticalAlignment="Center"
                                          Width="220" />
                            </StackPanel>
                            
                            <!-- Directorio label on the left -->
                            <TextBlock DockPanel.Dock="Left" Text="📍 Directorio:" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextTertiaryBrush}" />
                            
                            <!-- Path input fills the remaining space -->
                            <TextBox Text="{Binding CurrentPath}"
                                     Classes="meta-input"
                                     FontSize="11.5"
                                     Height="28"
                                     Padding="8,4"
                                     IsReadOnly="True"
                                     VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <!-- Files Grid -->
                    <DataGrid ItemsSource="{Binding Files}"
                              SelectedItem="{Binding SelectedFile}"
                              AutoGenerateColumns="False"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              CanUserReorderColumns="True"
                              SelectionMode="Extended"
                              IsReadOnly="True"
                              Margin="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="" Binding="{Binding IconGlyph}" Width="36" IsReadOnly="True" />
                            <DataGridTextColumn Header="Nombre de Archivo" Binding="{Binding Name}" Width="2*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Formato" Binding="{Binding FileType}" Width="*" IsReadOnly="True" IsVisible="{Binding $parent[DataGrid].((vm:MainViewModel)DataContext).IsTypeColumnVisible}" />
                            <DataGridTextColumn Header="Tamaño" Binding="{Binding SizeFormatted}" Width="90" IsReadOnly="True" IsVisible="{Binding $parent[DataGrid].((vm:MainViewModel)DataContext).IsSizeColumnVisible}" />
                            <DataGridTextColumn Header="Dimensiones" Binding="{Binding Resolution}" Width="120" IsReadOnly="True" IsVisible="{Binding $parent[DataGrid].((vm:MainViewModel)DataContext).IsResolutionColumnVisible}" />
                            <DataGridTextColumn Header="Coordenadas" Binding="{Binding GpsCoordinates}" Width="180" IsReadOnly="True" IsVisible="{Binding $parent[DataGrid].((vm:MainViewModel)DataContext).IsGpsColumnVisible}" />
                            <DataGridTextColumn Header="Última Modificación" Binding="{Binding DateModified, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="140" IsReadOnly="True" IsVisible="{Binding $parent[DataGrid].((vm:MainViewModel)DataContext).IsDateColumnVisible}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Separator 2 -->
            <Border Grid.Column="4" Background="{DynamicResource BorderSubtleBrush}" />

            <!-- ========================================== -->
            <!-- 4. INFORMACION Y METADATOS (RIGHT PANEL)   -->
            <!-- ========================================== -->
            <Border Grid.Column="5" Background="{DynamicResource BgSecondaryBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,12" Spacing="4">

                        <!-- Panel Header -->
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <StackPanel>
                                <TextBlock Text="Inspector de Propiedades" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding SelectedFileName}" FontSize="11" Foreground="{DynamicResource TextAccentBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,6" />

                        <!-- Buttons Panel (Guardar & Deshacer) -->
                        <Grid ColumnDefinitions="*,8,*" Margin="0,2,0,10">
                            <Button Grid.Column="0" Classes="action-btn" Content="💾 Guardar" Command="{Binding SaveMetadataCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="12" Padding="0,8" />
                            <Button Grid.Column="2" Classes="toolbar-btn" Content="↺ Deshacer" Command="{Binding UndoChangesCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="12" Padding="0,8" BorderThickness="1" BorderBrush="{DynamicResource BorderDefaultBrush}" />
                        </Grid>

                        <!-- ===== General Info Section (Card Style) ===== -->
                        <Border Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Margin="0,3">
                            <Expander IsExpanded="True" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="📋" FontSize="12.5" VerticalAlignment="Center" />
                                        <TextBlock Text="Información del Archivo" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding GeneralInfo}" ItemTemplate="{StaticResource MetadataEntryTemplate}" Margin="0,6,0,0" />
                            </Expander>
                        </Border>

                        <!-- ===== EXIF Section (Card Style) ===== -->
                        <Border Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Margin="0,3">
                            <Expander IsExpanded="False" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="📷" FontSize="12.5" VerticalAlignment="Center" />
                                        <TextBlock Text="EXIF / Hardware" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding ExifData}" ItemTemplate="{StaticResource MetadataEntryTemplate}" Margin="0,6,0,0" />
                            </Expander>
                        </Border>

                        <!-- ===== Authorship Section (Card Style) ===== -->
                        <Border Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Margin="0,3">
                            <Expander IsExpanded="True" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="👤" FontSize="12.5" VerticalAlignment="Center" />
                                        <TextBlock Text="Autoría &amp; Derechos" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding AuthorshipData}" ItemTemplate="{StaticResource MetadataEntryTemplate}" Margin="0,6,0,0" />
                            </Expander>
                        </Border>

                        <!-- ===== GPS Section (Card Style) ===== -->
                        <Border Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Margin="0,3">
                            <Expander IsExpanded="True" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" Width="290">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="🌍" FontSize="12.5" VerticalAlignment="Center" />
                                            <TextBlock Text="Geolocalización GPS" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" 
                                                  SelectedItem="{Binding SelectedGpsFormat}"
                                                  FontSize="10.5"
                                                  Height="24"
                                                  Padding="6,2"
                                                  Background="{DynamicResource BgSecondaryBrush}"
                                                  BorderThickness="1"
                                                  BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Width="95"
                                                  Margin="0,0,10,0">
                                            <x:String>Decimal</x:String>
                                            <x:String>DMS</x:String>
                                        </ComboBox>
                                    </Grid>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding GpsData}" ItemTemplate="{StaticResource MetadataEntryTemplate}" Margin="0,6,0,0" />
                            </Expander>
                        </Border>

                        <!-- ===== IPTC / XMP Section (Card Style) ===== -->
                        <Border Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Margin="0,3">
                            <Expander IsExpanded="True" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="📝" FontSize="12.5" VerticalAlignment="Center" />
                                        <TextBlock Text="IPTC / XMP" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding IptcData}" ItemTemplate="{StaticResource MetadataEntryTemplate}" Margin="0,6,0,0" />
                            </Expander>
                        </Border>

                        <Border Height="20" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        </DockPanel>

        <!-- ============================================================ -->
        <!-- FLOATING DIALOG OVERLAY: Backup Confirmation Dialog         -->
        <!-- ============================================================ -->
        <Grid Background="#A0000000" IsVisible="{Binding IsBackupDialogOpen}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{DynamicResource BgElevatedBrush}"
                    BorderBrush="{DynamicResource BorderFocusBrush}"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Width="450"
                    Height="210"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 32 #A0000000">
                <StackPanel Margin="24" Spacing="16">
                    <!-- Title -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="💾" FontSize="20" VerticalAlignment="Center" />
                        <TextBlock Text="Confirmar Guardado" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Message -->
                    <TextBlock Text="¿Deseas crear una copia de seguridad (.bak) del archivo original antes de aplicar y guardar los cambios de metadatos?"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0" HorizontalAlignment="Right">
                        <Button Classes="toolbar-btn" Content="Cancelar" Command="{Binding CancelSaveCommand}" Padding="16,8" />
                        <Button Classes="toolbar-btn" Content="No, guardar directo" Command="{Binding ConfirmSaveCommand}" CommandParameter="False" Padding="14,8" BorderThickness="1" BorderBrush="{DynamicResource BorderDefaultBrush}" />
                        <Button Classes="action-btn" Content="Sí, crear backup" Command="{Binding ConfirmSaveCommand}" CommandParameter="True" Padding="16,8" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
